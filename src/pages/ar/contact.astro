---
import PageLayout from '../../layouts/PageLayout.astro';
import { CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'ar';
const description = 'راسلنا إذا وجدت رقماً قديماً في سلم الرواتب، أو اختلف مسير راتبك أو مخالصتك عن الحاسبة، أو أردت تضمين الحاسبة في موقعك. لا نقدم استشارات فردية.';
---
<PageLayout title={`التواصل مع ${SITE_NAMES[lang]}: الإبلاغ عن خطأ وتضمين الحاسبة`} description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'التواصل', description, path: route('contact', lang), lang })]} breadcrumbs={[{ label: 'التواصل' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>التواصل</h1>
    <p>البريد: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. نرد عادة خلال أسبوع.</p>
    <h2>اختلف مسير راتبك أو مخالصتك عن الحاسبة</h2>
    <p>أرسل رابط المشاركة من الحاسبة والأرقام التي في مسير الراتب أو المخالصة، دون اسمك أو رقم هويتك أو رقمك الوظيفي. أكثر أسباب الاختلاف شيوعاً: بدلات خاصة بالوظيفة، أو درجة غير التي أدخلتها، أو نظام تقاعد مختلف، أو عمولات استبعدت من أجر نهاية الخدمة باتفاق. إن كان الخطأ عندنا صححناه وأضفنا الحالة إلى اختباراتنا.</p>
    <h2>تضمين الحاسبة</h2>
    <p>المدونات والمنتديات وجمعيات الموظفين يمكنها تضمين الحاسبة مجاناً: <a href={route('widget', lang)}>ضع الحاسبة في موقعك</a>.</p>
    <h2>ما لا نقدمه</h2>
    <p>لا نقدم استشارة في حالة فردية، ولا نراجع عقد عمل، ولا نتواصل مع جهة عملك أو مع أي جهة حكومية نيابة عنك، ولا نحيلك إلى محام أو بنك. أسئلة الأهلية في حساب المواطن تجيب عنها جهة البرنامج، وأسئلة المعاش تجيب عنها المؤسسة العامة للتأمينات الاجتماعية، ونزاعات العمل يفصل فيها ما يحدده نظام العمل.</p>
  </div>
</PageLayout>
