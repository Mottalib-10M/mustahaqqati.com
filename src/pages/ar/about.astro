---
import PageLayout from '../../layouts/PageLayout.astro';
import { YEAR, LAST_UPDATED, AUTHOR_NAME, CONTACT_EMAIL, AUTHOR_ROLE, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { personSchema, organizationSchema, breadcrumbSchema, profilePageSchema } from '../../lib/seo';
import { displayDate, hijriDate } from '../../lib/format';
const lang = 'ar';
---
<PageLayout title="من نحن: ناشر حاسبات مستحقاتي للرواتب ونهاية الخدمة" description="من يقف وراء حاسبات سلم الرواتب ونهاية الخدمة وحساب المواطن والتقاعد في مستحقاتي، وكيف نتحقق من كل رقم، وما الذي لا يفعله الموقع ولا يدعيه لنفسه أبداً." lang={lang} jsonLd={[personSchema(lang), organizationSchema(lang), profilePageSchema({ path: route('about', lang), lang }), breadcrumbSchema([{ name: 'الرئيسية', path: route('home', lang) }, { name: 'من نحن', path: route('about', lang) }])]} breadcrumbs={[{ label: 'من نحن' }]}>
  <header class="mb-6"><h1 class="text-3xl font-bold text-navy-900 md:text-4xl">من نحن</h1></header>
  <div class="prose prose-slate max-w-none">
    <div class="not-prose mb-6"><p class="text-lg font-semibold text-navy-900">{AUTHOR_NAME}</p><p class="text-navy-700">{AUTHOR_ROLE[lang]}</p></div>
    <p>{SITE_NAMES[lang]} موقع تنشره Radif Partners، وهي ناشر مستقل للحاسبات. بدأ المشروع من قراءة نتائج البحث عن «سلم رواتب الموظفين» و«حاسبة نهاية الخدمة» و«حاسبة حساب المواطن» في أكتوبر 2026: جداول رواتب بلا تاريخ اعتماد ولا مصدر، وأرقام متناقضة بين موقع وآخر في المرتبة نفسها، ومقالات تحسب مكافأة نهاية الخدمة على الراتب الأساسي وحده مع أن نظام العمل يتخذ الأجر الأخير أساساً ويعرّف الأجر الفعلي بالبدلات، وحاسبات رسمية لا تعمل إلا بتشغيل برامج الصفحة أو صفحاتها غير متاحة.</p>
    <h2>لماذا هذا الموقع أفضل من أول نتيجة في Google</h2>
    <p>هذا الموقع أفضل من أول نتيجة في Google لأن كل جدول فيه يحمل تاريخ اعتماده ورابط نصه الرسمي، ولأن حاسبة نهاية الخدمة تطبق المواد 84 و85 و87 من نظام العمل على الأجر الفعلي الأخير كما يعرفه النظام، لا على الأساسي وحده، ولأن الراتب والعلاوة القادمة ونهاية الخدمة وتقدير حساب المواطن والمعاش تجتمع في مكان واحد بأرقام مختبرة، دون تسجيل ولا نموذج ولا رقم جوال.</p>
    <h2>كيف نتحقق</h2>
    <p>نقلنا سلم الموظفين العام من نسخة رسمية منشورة لدى جامعة حكومية وقابلناه بنسخة أخرى خانة بخانة، وسلم المعلمين من ملف وزارة التعليم، والبدلات من لائحة الحقوق والمزايا المالية، ونصوص نظام العمل وأنظمة التقاعد من موقع هيئة الخبراء بمجلس الوزراء. كل نتيجة في الحاسبات تخضع لاختبارات آلية قبل النشر. الطريقة كاملة في <a href={route('method', lang)}>طريقة الحساب</a>.</p>
    <h2>ما لسنا عليه</h2>
    <p>لسنا جهة حكومية، ولا نتبع وزارة الموارد البشرية ولا وزارة التعليم ولا برنامج حساب المواطن ولا التأمينات الاجتماعية. لسنا صاحب عمل ولا بنكاً ولا مكتب محاماة ولا مكتب موارد بشرية. لا نقرر أهليتك لأي دعم. المرجع النهائي مسير راتبك ومخالصتك وقرار الجهة المختصة.</p>
    <h2>التمويل وبياناتك</h2>
    <p>الحاسبات مجانية. ما تدخله يبقى في متصفحك. لا يدفع لنا أحد مقابل توجيهك إلى منتج مالي، وإن ظهرت إعلانات فلن تكون فوق الحاسبة ولا داخل النتيجة.</p>
    <h2>ما ليس في الموقع بعد</h2>
    <p>سلم رواتب العسكريين، لأننا لم نجد نسخته الحالية في مصدر رسمي يمكن الإحالة إليه، وسلالم الأطباء والمهندسين والقضاة، ومكافأة نهاية الخدمة لموظفي الدولة الخاضعين لأنظمة الخدمة المدنية. سنضيف كل جدول حين نتحقق منه في مصدره.</p>
    <h2>التواصل</h2>
    <p>رقم قديم أو مسير راتب يختلف عن الحاسبة؟ راسلنا على <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. انظر أيضاً <a href={route('editorial', lang)}>سياسة التحرير</a> و<a href={route('terms', lang)}>الإشعار القانوني</a>.</p>
    <p class="text-sm text-navy-600">الأنظمة كما في {YEAR}، آخر مراجعة <time datetime={LAST_UPDATED}>{hijriDate(LAST_UPDATED)}</time> ({displayDate(LAST_UPDATED, 'ar-SA')}).</p>
  </div>
</PageLayout>
