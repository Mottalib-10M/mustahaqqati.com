---
import PageLayout from '../../layouts/PageLayout.astro';
import { AUTHOR_NAME, CONTACT_EMAIL, LAST_UPDATED, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
const lang = 'ar';
---
<PageLayout title={`سياسة التحرير في ${SITE_NAMES[lang]}: من أين يأتي كل رقم`} description="كيف نختار المصادر الرسمية ونؤرخها، ومتى نحدث سلالم الرواتب، ولماذا لا ننشر رقماً بلا مصدر، وكيف نصحح الأخطاء ونفصل بين المعلومة والإعلان." lang={lang} noindex={true} breadcrumbs={[{ label: 'سياسة التحرير' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>سياسة التحرير</h1>
    <h2>رقم بلا مصدر لا ينشر</h2>
    <p>كل مبلغ أو نسبة أو مدة في الموقع تأتي من نص رسمي: أمر ملكي، أو نظام منشور في موقع هيئة الخبراء بمجلس الوزراء، أو لائحة منشورة لدى وزارة حكومية، أو نسخة رسمية لسلم الرواتب نشرتها جهة حكومية أو جامعة حكومية. نكتب تاريخ اعتماد كل سلم بالهجري والميلادي. إذا لم نجد النسخة الرسمية الحالية لجدول ما تركناه خارج الموقع، كما فعلنا مع سلم رواتب العسكريين.</p>
    <h2>التقدير يسمى تقديراً</h2>
    <p>برنامج حساب المواطن لا ينشر جدول حسابه. ما نعرضه يعيد إنتاج نتائج حاسبته التقديرية الرسمية، ونكتب ذلك في كل صفحة. القرار في الأهلية والمبلغ للبرنامج وحده.</p>
    <h2>الزيادات المعلنة</h2>
    <p>لا تدخل زيادة في الحساب قبل نشر نصها أو جدولها. ما أعلن ولم ينشر يكتب بعبارة «قادم» دون أرقام مخمنة.</p>
    <h2>التحديث والتصحيح</h2>
    <p>نراجع المصادر عند كل تعديل نظامي، وعند بداية كل سنة هجرية لموعد العلاوة. كل صفحة تحمل تاريخ آخر مراجعة. إذا وجدنا خطأ صححناه وأضفنا الحالة إلى الاختبارات الآلية التي تسبق كل نشر.</p>
    <h2>الاستقلال</h2>
    <p>لا يدفع لنا بنك ولا جهة تمويل ولا مكتب موارد بشرية مقابل ذكره أو توجيه القراء إليه، ولا نضع روابط تجارية في نتائج الحاسبات. إن ظهرت إعلانات يوماً فلن تكون فوق الحاسبة ولا داخل نتيجتها.</p>
    <p>المحرر: {AUTHOR_NAME}. ملاحظاتك على <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. انظر <a href={route('method', lang)}>طريقة الحساب</a> و<a href={route('about', lang)}>من نحن</a>. آخر تحديث: {LAST_UPDATED}.</p>
  </div>
</PageLayout>
