---
/** Calculateur à intégrer (iframe) : sans navigation, noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import EosCalc from '../../components/calc/EosCalc';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="ar-SA" dir="rtl">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>حاسبة مكافأة نهاية الخدمة (تضمين)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('nihayat-alkhidma', 'ar')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <EosCalc client:load methodHref={`${SITE_URL}${route('method', 'ar')}`} idPrefix="emb" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${route('nihayat-alkhidma', 'ar')}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.ar}</a> · المواد 84 و85 و87 من نظام العمل، محسوبة في متصفحك</p>
  </body>
</html>
